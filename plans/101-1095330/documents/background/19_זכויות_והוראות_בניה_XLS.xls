  <style>td { text-align:right; } th { mso-number-format:\@;}.clsTableHeader{border-right: 1px solid #006699;	border-bottom: 1px solid #006699;	padding: 2px;	background-color: #d5e4ed;	font-size: 100%;  text-align:center;}.clsTableCell{ mso-number-format:\@; 	border-right: 1px solid #006699;	border-bottom: 1px solid #006699;	padding: 2px;	font-size: 100%;}tr.clsTableRowNormal{	background-color: #ffffff;}</style><meta charset=utf-8 /><table cellpadding='0' cellspacing='0' style='width:100%' id='tblPlanLanduseRights'><thead><tr><th class='clsTableHeader'></th><th class='clsTableHeader' colspan=4>ברירות מחדל לערכים</th><th class='clsTableHeader' colspan=1>מ"ר</th><th class='clsTableHeader' colspan=4>מ"ר</th><th class='clsTableHeader' colspan=1>מספר חפשי</th><th class='clsTableHeader' colspan=1>מטר</th><th class='clsTableHeader' colspan=1>מספר חפשי</th><th class='clsTableHeader' colspan=4>מטר</th><th class='clsTableHeader' colspan=1>מ"ר</th></tr><tr><th class='clsTableHeader' rowspan='2'></th><th class='clsTableHeader' colspan='4' rowspan='2'>&nbsp;</th><th class='clsTableHeader' rowspan='2' colspan=1>גודל מגרש</th><th class='clsTableHeader' colspan=4>שטחי בניה</th><th class='clsTableHeader' rowspan='2' colspan=1></th><th class='clsTableHeader' rowspan='2' colspan=1></th><th class='clsTableHeader' rowspan='2' colspan=1>מספר קומות</th><th class='clsTableHeader' rowspan='2' colspan=4>קו בנין</th><th class='clsTableHeader' rowspan='2' colspan=1></th></tr><tr><th class='clsTableHeader' colspan=2>מעל הכניסה הקובעת</th><th class='clsTableHeader' colspan=2>מתחת לכניסה הקובעת</th></tr><tr><th class='clsTableHeader'></th><th class='clsTableHeader'>יעוד ראשי<div style='min-width: 40px;'><span class='btnClearFilter' onclick='clearFilter()' title='ניקוי סינון'></span><span class='btnFilter' onclick='showFilterMainLandUsePopUp()' title='פתח חלון סינון'></span></div></th><th class='clsTableHeader'>שימוש</th><th class='clsTableHeader'>תאי שטח</th><th class='clsTableHeader'>בניין / מקו