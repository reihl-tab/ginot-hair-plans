bsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="מגורים מסחר ותעסוקה"><td  class="clsTableCell"></td><td class="clsTableCell">מגורים מסחר ותעסוקה</td><td class="clsTableCell">מסחר</td><td class="clsTableCell">1</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">7749</td><td class="clsTableCell">3180</td><td class="clsTableCell">116</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(6)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="מגורים מסחר ותעסוקה"><td  class="clsTableCell"></td><td class="clsTableCell">מגורים מסחר ותעסוקה</td><td class="clsTableCell">תעסוקה</td><td class="clsTableCell">1</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">7749</td><td class="clsTableCell">17910</td><td class="clsTableCell">1000</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="מגורים מסחר ותעסוקה"><td  class="clsTableCell"></td><td class="clsTableCell">מגורים מסחר ותעסוקה</td><td class="clsTableCell">מבנים ומוסדות ציבור</td><td class="clsTableCell">1</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">7749</td><td class="clsTableCell">3495</td><td class="clsTableCell">800</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="מבנים ומוסדות ציבור"><td  class="clsTableCell"></td><td class="clsTableCell">מבנים ומוסדות ציבור</td><td class="clsTableCell">מבנים ומוסדות ציבור</td><td class="clsTableCell">3</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">3715</td><td class="clsTableCell">6241</td><td class="clsTableCell">2675</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">11000</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">6</td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell"><sup>(3)</sup></td><td class="clsTableCell">&nbsp;</td></tr><tr style="cursor: pointer" class="clsTableRowNormal" title="סכום"><td  class="clsTableCell">סך הכל</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">8</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">42460</td><td class="clsTableCell">89219</td><td class="clsTableCell">20072</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">49000</td><td class="clsTableCell">662</td><td class="clsTableCell">238</td><td class="clsTableCell">69</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">&nbsp;</td><td class="clsTableCell">7632</td></tr></tbody></table><br><br><Table border=1><TR><TD><B>מספר</B></TD><TD><B>הערות לטבלת זכויות והוראות בניה - מצב מוצע</B></TD></TR><TR><TD>1</TD><TD> מעל גובה זה תותר בניית מעקה עפ"י תקן, קומות טכניות עבור חדרים טכניים, מערכות טכניות וחדר יציאה לגג.</TD></TR><TR><TD>2</TD><TD> לא כולל חדר מכונות/חדר יציאה לגג, גלריה למסחר וקומות טכניות.</TD></TR><TR><TD>3</TD><TD> כמסומן בתשריט.</TD></TR><TR><TD>4</TD><TD> אם זכויות הבניה "המותנות" ימומשו גובה המבנה המירבי יהיה  עד 121 מ' (4 מ' נוספים מעבר לגובה המצוין בטבלה).</TD></TR><TR><TD>5</TD><TD> אם זכויות הבניה "המותנות" ימומשו תותר הקמת מבנה בגובה של עד 32  קומות (קומה מעבר למספר הקומות המצוין בטבלה).</TD></TR><TR><TD>6</TD><TD> תותר הוספת גלריה לקומות המסחר עד 50% משטח הקומה שלא כחלק ממניין הקומות.</TD></TR></Table><br><br><Table border=1><TR><TD><B>הערות ברמת טבלה</B></TD></TR><TR><TD>א. יותר ניוד שטחים עיקריים מהמפלס שמעל לכניסה הקובעת אל מתחת לכניסה הקובעת.
ב. תותר העברת שטחים בין שימושי מסחר ותעסוקה. שטחי המסחר לא יפחתו מהשטחים המפורטים בטבלה. 
ג. בשטחי המסחר תותר בניית גלריה בהיקף של עד 50% מהתכסית, בנוסף לשטחים המבוקשים. 
ד. בקומות הפנטהאוס של המגדלים תותר בניית גלריה, לא כחלק ממניין הקומות ובנוסף לשטחים המבוקשים.
ה. תותר הגבהת 4 חזיתות הבניין לצורך הסתרת מתקנים טכניים.
ו. יותרו שטחי בניה זמניים לצורך התארגנות ומשרדי קבלן.
ז. לעת מתן היתר בניה, תותר הוספת קומות ושטחים תת קרקעיים לצורך חניות עפ"י תקן תקף.
ח. יותר ניוד שטחים מעל הקרקע אל תת הקרקע לעת מתן היתר בניה, זאת בתנאי שסה"כ שטחי הבניה לא יעלה על סך השטחים המצוינים בטבלה 5 ולא תחול חריגה בגובה המבנים.
ט. חצרות מקורות, אמצעי הגנה או הצללה על חצרות גני הילדים לא יחושבו במניין השטחים.
י. שטחי השירות כוללים שטחים להקמת מרחבים מוגנים קומתיים. ככל שפתרון המיגון יהיה מרחב מוגן דירתי, שטחי הממ"ד עבור כל דירה יחושבו מהשטחים העיקריים ויומרו לשטחי שירות.
יא. לא יותר ניוד שטחים שאינם למגורים לשימושי המגורים.
יב. מימוש השטחים למסחר ותעסוקה בתכנית זו הינו מחייב.</TD></TR></Table><br><br>